# ============================================================
#  Configuracao (copie para .env e preencha)
#  No Termux:  cp .env.example .env  &&  nano .env
# ============================================================

# --- Mercado Pago (obrigatorio para gerar Pix) ---
MERCADO_PAGO_ACCESS_TOKEN=[cole aqui]
MERCADO_PAGO_PUBLIC_KEY=[cole aqui]

# Segredo do webhook (opcional, so no modo webhook/HTTPS).
# Se preencher, o /mp/webhook so aceita chamadas com a assinatura oficial do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Painel ---
# Senha de login. Se voce NAO preencher, o sistema gera uma senha aleatoria na
# primeira execucao e mostra no log (e em data/admin-password.txt). Nao existe
# mais a senha padrao "admin".
ADMIN_PASSWORD=[cole aqui]

# --- Onde o app roda ---
# BASE_URL VAZIO = MODO CELULAR (Termux) / PC local:
#   o Telegram usa polling (getUpdates) e o Pix e confirmado pelo job de 60s.
#   Nao precisa de dominio nem HTTPS.
# Com dominio publico HTTPS (Railway/Render/VPS) o Telegram passa a usar webhook.
# Ex.: BASE_URL=https://painel.seudominio.com
BASE_URL=

# Porta do painel.
PORT=3000

# Pasta dos dados (SQLite + uploads). No celular: ./data
DATA_DIR=./data
